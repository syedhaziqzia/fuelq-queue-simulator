<Window x:Class="FuelQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuelQ — Shell Petrol Pump Maskan Branch Simulator"
        Height="780" Width="1280"
        MinHeight="660" MinWidth="980"
        Background="{StaticResource CanvasBackground}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppLogo.jpg"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- ══════════════════════════════════
             IN-APP MODAL OVERLAY (ZIndex 1000)
             ══════════════════════════════════ -->
        <Grid x:Name="ModalOverlay" Panel.ZIndex="1000" Visibility="Collapsed">
            <Rectangle Fill="#D90B0A08" MouseLeftButtonDown="ModalBackdrop_Click"/>
            <Border x:Name="ModalCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="720"
                    Background="{StaticResource CardSurface}"
                    BorderBrush="#5C4A26"
                    BorderThickness="1" CornerRadius="14" Margin="40"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
                        <Grid>
                            <TextBlock x:Name="ModalTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5"
                                    Click="CloseModal_Click" FontSize="13"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="ModalContent" Margin="20,16,20,20"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════════
             MAIN LAYOUT
             ════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Border Grid.Column="0" x:Name="SidebarPanel" Width="260"
                    Background="{StaticResource SidebarSurface}"
                    BorderBrush="{StaticResource SidebarBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel ClipToBounds="True">

                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,12,10">
                        <Grid Margin="0,0,0,8">
                            <StackPanel x:Name="BrandLogoPanel" Orientation="Horizontal">
                                <Border CornerRadius="12" Margin="0,0,12,0" Width="52" Height="52"
                                        BorderBrush="#5C4A26" BorderThickness="1" Background="{StaticResource InputSurface}">
                                    <Border CornerRadius="11">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/AppLogo.jpg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Fuel" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Q" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TbSidebarSubtitle" Text="Maskan forecourt simulator" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="BtnToggleSidebar" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="◀" FontSize="10" Style="{StaticResource NavButton}"
                                    Padding="7,4" Margin="0"
                                    Click="ToggleSidebar_Click"
                                    ToolTip="Collapse sidebar"/>
                        </Grid>
                        <!-- Road-marking divider -->
                        <Rectangle Height="2" Margin="0,4,0,8" RadiusX="1" RadiusY="1">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFB020" Offset="0"/>
                                    <GradientStop Color="#00FFB020" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock x:Name="TbSidebarMeta" Text="GROUP G · UBIT · BSCS 6th Semester" FontFamily="{StaticResource DisplayFont}" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <TextBlock x:Name="TbNavLabel" DockPanel.Dock="Top" Text="WORKFLOW" Style="{StaticResource SectionLabel}" Margin="20,8,0,6"/>

                    <!-- Footer -->
                    <Border x:Name="PanelSupervisor" DockPanel.Dock="Bottom" Margin="12,0,12,14" Background="{StaticResource InputSurface}"
                            BorderBrush="{StaticResource SidebarBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="SUPERVISOR" FontFamily="{StaticResource DisplayFont}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="Dr. Shaista Rais" FontFamily="{StaticResource DisplayFont}" FontSize="13.5" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="Modeling &amp; Simulation · UBIT" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav: buttons + sliding amber indicator -->
                    <Grid x:Name="NavHost">
                        <StackPanel x:Name="NavStack" Margin="8,0,8,0">
                            <Button x:Name="NavBtn0" Style="{StaticResource NavButton}" Tag="0" Click="NavButton_Click" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconHome}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNavText0" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Run Text="Home"/><LineBreak/><Run Text="What FuelQ does" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button x:Name="NavBtn1" Style="{StaticResource NavButton}" Tag="1" Click="NavButton_Click" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconFormula}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNavText1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Run Text="Queue Calculator"/><LineBreak/><Run Text="1 · Answer with formulas" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button x:Name="NavBtn2" Style="{StaticResource NavButton}" Tag="2" Click="NavButton_Click" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconPump}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNavText2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Run Text="DES Simulator"/><LineBreak/><Run Text="2 · Simulate vehicle by vehicle" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button x:Name="NavBtn3" Style="{StaticResource NavButton}" Tag="3" Click="NavButton_Click" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconBars}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNavText3" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Run Text="Empirical Data"/><LineBreak/><Run Text="3 · Test the arrival data" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button x:Name="NavBtn4" Style="{StaticResource NavButton}" Tag="4" Click="NavButton_Click" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconCurves}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNavText4" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Run Text="Model Comparison"/><LineBreak/><Run Text="4 · Compare all models" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>

                            <Button x:Name="NavBtn5" Style="{StaticResource NavButton}" Tag="5" Click="NavButton_Click" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconAudit}" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNavText5" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Run Text="AI Prompts &amp; Audit"/><LineBreak/><Run Text="How it was built" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Slides to the active page -->
                        <Border x:Name="NavIndicator" Width="4" Height="26" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0"
                                Background="{StaticResource AccentCyanBrush}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFB020" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- ── MAIN CONTENT ── -->
            <ContentControl Grid.Column="1" x:Name="MainContent" Background="{StaticResource CanvasBackground}"/>
        </Grid>
    </Grid>
</Window>
