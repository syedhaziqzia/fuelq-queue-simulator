<UserControl x:Class="FuelQ.Views.PromptAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBackground}"
             FontFamily="{StaticResource BodyFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,22,24,28">

            <!-- Title Header -->
            <TextBlock Text="AI Prompts &amp; Engineering Audit"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Traceability Log  ·  Course-Derived Prompts, Architectural Iterations &amp; Theoretical Validation"
                       Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,22"/>

            <!-- SECTION 1: AI Prompt Engineering & Queueing Model Formulations -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,20" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Queueing Theory Models · Mathematical Formulation Prompts"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="6 Model Prompts" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Individual mathematical prompts used to formulate, implement, and verify each analytical and approximation queueing model in FuelQ, derived directly from course syllabus notes, Kendall notation, and Shell Maskan forecourt operational parameters."
                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- PROMPT 1: M/M/1 Single Server -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Model 1 · M/M/1" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Single-Server Markovian Queue (Exact Baseline)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Exact Closed-Form" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Implement the foundational single-server M/M/1 analytical queue solver for our forecourt project, establishing our baseline for Poisson vehicle arrivals (rate λ) and exponential dispensing times (rate μ). Check if the queue is unstable (λ ≥ μ or ρ ≥ 1) and return an explicit error. When stable, derive the primary closed-form metrics: traffic intensity a = ρ = λ/μ, average queue length Lq = ρ²/(1−ρ), waiting time in queue Wq = Lq/λ, total system time W = Wq + 1/μ, and total vehicles in system L = λ·W. Calculate idle probability P₀ = 1−ρ, probability of delay Pw = ρ, and compute the geometric state probabilities P(n) = (1−ρ)·ρⁿ for n = 0 to 10.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: MM1Calculator.cs, foundational single-server closed-form solver, stability validation, and geometric state distribution P(n)." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROMPT 2: M/M/s Multi-Server Erlang-C -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Model 2 · M/M/s" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Multi-Server Erlang-C Forecourt Dispenser Model" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Erlang-C Formulation" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Building upon the M/M/1 baseline, implement the multi-server M/M/s queue calculator to model s parallel pumps at the Shell Maskan forecourt sharing arrival rate λ with service rate μ per pump. Verify multi-server stability λ &lt; s·μ and allow up to s = 50 servers. Calculate offered load a = λ/μ and server utilization ρ = a/s. Implement the Erlang-C formulas: compute P₀ via summation P₀ = [∑(aⁿ/n!) + (aˢ/(s!(1−ρ)))]⁻¹ with factorial overflow handling, then compute Erlang-C delay probability Pw = C(s, a) = [aˢ/(s!(1−ρ))]·P₀. Evaluate queue length Lq = Pw·ρ/(1−ρ), queue wait Wq = Lq/λ, system time W = Wq + 1/μ, and total vehicles L = λ·W, supporting piecewise state probabilities P(n) for n = 0 to 10.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: MMsCalculator.cs, multi-server Erlang-C expansion from M/M/1, factorial scaling up to s=50, and piecewise state distribution." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROMPT 3: M/G/1 Pollaczek-Khinchine -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Model 3 · M/G/1" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Single-Server General Service Queue (Pollaczek-Khinchine)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Pollaczek-Khinchine" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Extend our queueing framework by relaxing the exponential service assumption: implement an M/G/1 single-server queue calculator where vehicle arrivals remain Poisson (λ) but dispensing follows an arbitrary general distribution with mean 1/μ and variance σ². Verify stability λ &lt; μ. Implement the exact Pollaczek-Khinchine (P-K) formula: determine the second moment E[S²] = (1/μ)² + σ², coefficient of variation Cs = σ/(1/μ), and expected queue wait Wq = [λ·(σ² + 1/μ²)] / [2·(1−ρ)]. Derive Lq = λ·Wq, W = Wq + 1/μ, and L = λ·W. Explicitly suppress the geometric P(n) state table as it is invalid for general service, and confirm that setting σ² = 0 reduces cleanly to M/D/1 determinism.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: MG1Calculator.cs, Pollaczek-Khinchine (P-K) general service formulation, second-moment calculation, and M/D/1 determinism verification." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROMPT 4: M/G/s Allen-Cunneen -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Model 4 · M/G/s" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Multi-Server General Service Queue (Allen-Cunneen Approx)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Allen-Cunneen Approx" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Following the single-server M/G/1 model, implement the multi-server M/G/s calculator to evaluate s parallel dispensers under Poisson arrivals (λ) and general service variance σ². Because exact closed-form solutions do not exist for multi-server general service, implement the Allen-Cunneen approximation by bridging our M/M/s engine. Verify stability λ &lt; s·μ and calculate baseline M/M/s waiting time Wq(M/M/s). Compute the squared coefficient of variation of service Cs² = σ² / (1/μ)², then scale expected queue wait using Wq ≈ [(1 + Cs²)/2] × Wq(M/M/s). Derive Lq = λ·Wq, W = Wq + 1/μ, and L = λ·W, adopting Erlang-C P₀ and Pw as operational bounds.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: MGsCalculator.cs, Allen-Cunneen multi-server approximation scaling baseline Erlang-C metrics by (1 + Cs²)/2 with variance sensitivity." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROMPT 5: G/G/1 Kingman -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Model 5 · G/G/1" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Single-Server General Arrivals &amp; Service (Kingman Formula)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Kingman Heavy-Traffic" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Advance our queueing suite to arbitrary distributions for both traffic and fueling: implement the single-server G/G/1 calculator parameterized by arrival rate λ, arrival variance σA², service rate μ, and service variance σS². Enforce stability λ &lt; μ and calculate squared coefficients of variation Ca² = σA²/(1/λ)² and Cs² = σS²/(1/μ)². Implement Kingman's heavy-traffic approximation formula: Wq ≈ [(Ca² + Cs²)/2] × [ρ/(1−ρ)] × (1/μ). Compute Lq = λ·Wq, W = Wq + 1/μ, and L = λ·W. Include notes explaining that Kingman provides an asymptotic upper bound that attains highest precision under heavy traffic loads (ρ → 1.0) and generalizes our earlier M/M/1 and M/G/1 models.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: GG1Calculator.cs, Kingman heavy-traffic approximation engine, dual arrival/service variability handling (Ca², Cs²), and upper-bound estimation." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- PROMPT 6: G/G/s Allen-Cunneen General -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,0" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Model 6 · G/G/s" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Multi-Server General Queuing Model (Allen-Cunneen General)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Allen-Cunneen Multi-Server" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Synthesize our multi-server architecture with dual arrival and service variability: implement the multi-server G/G/s queue calculator for s parallel petrol pumps subject to non-exponential arrivals (variance σA²) and general service times (variance σS²). Check multi-server stability λ &lt; s·μ. Compute arrival variability Ca² = σA²/(1/λ)² and service variability Cs² = σS²/(1/μ)². Leverage our baseline M/M/s Erlang-C calculator to obtain Wq(M/M/s), and apply the generalized Allen-Cunneen approximation: Wq ≈ [(Ca² + Cs²)/2] × Wq(M/M/s). Derive Lq = λ·Wq, W = Wq + 1/μ, and L = λ·W, quantifying how joint variability Ca² + Cs² compounds congestion across the forecourt.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: GGsCalculator.cs, generalized Allen-Cunneen multi-server approximation combining dual variability (Ca², Cs²) with baseline Erlang-C." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Core Platform & Simulation Engine Prompts -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,20" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Platform Architecture &amp; Simulation Engine · Core System Prompts"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="6 System Prompts" FontSize="9.5" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Core engineering prompts used to construct the desktop WPF interface, discrete event simulation engine, stochastic sampling algorithms, empirical data auditing, and academic export tools."
                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- SYSTEM PROMPT 1: UI Foundation -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="System 1 · UI Shell" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="WPF Modern Dark UI Shell &amp; Sidebar Navigation" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="UI Foundation" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Let's build a clean, modern WPF desktop app for our FuelQ simulator using .NET 10. I want a dark theme with a deep navy background, sleek card panels, and clean blue/cyan accents with zero third-party UI packages. Set up a main window with a left sidebar containing our logo, project title, and navigation buttons for: Home &amp; Team, Queue Calculator, DES Simulator, Empirical Data, Model Comparison, and AI Prompts. Use a ContentControl in the main area to switch views smoothly.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: MainWindow shell, dark theme color palette in App.xaml, and modular view navigation." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM PROMPT 2: Calculator GUI View -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="System 2 · Calculator GUI" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Queue Calculator Interactive View &amp; Real-Time Parameter Sync" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Interactive GUI" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Build the interactive Queue Calculator view in WPF. Integrate tabs for all 6 Kendall models (M/M/1, M/M/s, M/G/1, M/G/s, G/G/1, G/G/s). Synchronize arrival rate λ and mean time 1/λ, as well as service rate μ and mean time 1/μ bidirectionally. Add a live stability badge showing ρ and a red warning when ρ ≥ 1.0. Display dynamic KPI cards for Lq, Wq, L, W, P₀, and Pw, and bind state probabilities P(n) for n = 0 to 10 into a styled DataGrid with visual progress bars.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: QueuingModelsView.xaml and code-behind, bidirectional unit conversions, stability badges, and styled state probability DataGrid." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM PROMPT 3: DES Simulator Engine -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="System 3 · DES Engine" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Discrete-Event Simulation (DES) Engine &amp; Custom Vector Charts" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="DES &amp; Vector Charts" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Create the DES Simulator module. We need an event-driven simulation engine with a priority queue for vehicle arrivals, pump assignment, and departures. Let users configure number of pumps, vehicle limit, and probability distributions (Exponential, Normal, Uniform, Gamma). Show real-time KPI cards (Wq, W, Lq, L, utilization) and draw two custom vector charts: a queue timeline Q(t) and a waiting time histogram using native WPF DrawingContext.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: GeneralDESimulator.cs (simulation table), ForecourtSimulator.cs (event-list DES), distribution samplers, and custom SimpleWpfChart vector graphics." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM PROMPT 4: Forecourt Calibration & Fleet Mix -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="System 4 · Forecourt Logic" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Site Forecourt Calibration &amp; 70/30 Vehicle Fleet Mix" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Forecourt Behavioral Logic" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Model the real-world operational rules of the Shell Maskan petrol pump forecourt in C#. Implement a fleet mix parameter of 70% motorcycles and 30% cars. Set motorcycle service to Exp(35s) and car service to Exp(85s). Implement bifurcated lane routing: 100% of bikes and 50% of cars pay cash at the 4B fast-exit lane, while the remaining 15% of cars use 4A-POS card/QR payment with an added Uniform[10, 25]s terminal delay. Route incoming vehicles to the pump island with the shortest queue.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: ForecourtSimulator.cs, 70/30 motorcycle/car fleet calibration, 4B-Cash vs 4A-POS payment branching, and shortest-queue routing heuristics." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM PROMPT 5: Empirical Data & Chi-Square -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="System 5 · Statistical Testing" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Empirical Dataset, Outlier Detection &amp; Chi-Square Test" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Data &amp; Hypothesis Test" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Add the Empirical Data module for our Shell Maskan observation data (320 vehicle records). Implement Tukey's IQR method to detect and flag outlier service times. Then, add a Pearson Chi-Square Goodness-of-Fit test at α = 0.05 with 10 bins to prove whether our observed arrival intervals statistically fit an Exponential distribution. Also calibrate the forecourt mix to 70% bikes and 30% cars with cash vs card payment delays.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: EmpiricalDataView, ChiSquareGoodnessOfFit.cs, IQR outlier detector, and a 320-row synthetic baseline generator (no field CSV is included in the project)." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM PROMPT 6: Comparison View & LaTeX Export -->
                    <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,0" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A2314" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="System 6 · Benchmarking" FontSize="10" FontWeight="Bold" Foreground="#FFC95C"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Model Comparison, Sensitivity Curves &amp; LaTeX Export" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Benchmarking &amp; Export" FontSize="9.5" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Border Background="#0E0D0B" BorderBrush="#2E2A23" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD5C7" LineHeight="17">
                                    <Run Foreground="{StaticResource AccentCyanBrush}" Text="Prompt: "/><Run Text="&quot;Create a Model Comparison view that compares analytical models (M/M/1, M/D/1, M/G/1, M/M/c) against DES simulation results side-by-side with percentage differences. Add a sensitivity curve chart showing how queue length (Lq) changes as utilization (ρ) increases towards 1.0, and include a button to copy the table as clean LaTeX code for our project report.&quot;"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Result: ModelComparisonView, Lq vs ρ sensitivity curve generator, and one-click LaTeX exporter." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Theoretical Assumptions & Validation Certification -->
            <TextBlock Text="Theoretical Assumptions &amp; Methodological Validation"
                       Style="{StaticResource CardTitle}"
                       FontSize="15"
                       Margin="0,4,0,10"/>

            <!-- Assumption 1: Poisson Arrivals -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,10" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="A1" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Assumption: Poisson Arrival Process (Markovian)"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Method demo (synthetic data)" FontSize="9" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="18">
                        <Run Text="H₀: Vehicle inter-arrival times follow an Exponential distribution (Poisson arrivals). The models assume λ ≈ 2.8 vehicles/minute at peak.&#10;&#10;"/>
                        <Run Text="Demonstration: Pearson Chi-Square Goodness-of-Fit on the 320-record synthetic baseline dataset (generated from Exp(λ = 2.8/min), seed 2026), 10 equal-probability bins (df = 8, α = 0.05). Computed χ² = 14.69 &lt; critical 15.507 (p = 0.066), so H₀ is not rejected, but only narrowly. Because this data was generated as exponential, the test demonstrates the method; it does not validate the real site. Load real observations with Browse CSV on the Empirical Data page to test the site itself."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Assumption 2: Fleet Mix -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,10" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="A2" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Assumption: 70/30 Fleet Heterogeneity Mix"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Model parameter" FontSize="9" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="18">
                        <Run Text="Traffic at Shell Maskan Chowrangi is motorbike-dominant, so the simulator assumes 70% motorbikes and 30% cars. This is a model parameter, not a measured value: no field counts are stored in the project.&#10;&#10;"/>
                        <Run Text="Impact: with mean service times of 35 s for a motorbike and 85 s for a car, a motorbike is served 58.8% faster than a car ((85 − 35) / 85). The 70/30 mix gives an average service time of 0.7 × 35 + 0.3 × 85 = 50 s, which lowers utilization by about 41% compared with an all-car fleet (1 − 50 / 85)."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Assumption 3: Service Distribution -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,10" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="A3" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Assumption: Exponential Service Time (Memoryless)"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="#211C12" BorderBrush="{StaticResource AccentBlueBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⚠ Approximation" FontSize="9" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="18">
                        <Run Text="Service duration at Shell Maskan depends on fuel amount, vehicle type, payment method (4B-Cash vs 4A-POS) and attendant speed, so an exponential (memoryless) service time is an approximation.&#10;&#10;"/>
                        <Run Text="Model Sensitivity: M/M/1 and M/M/c assume exponential service. The M/G/1 (Pollaczek-Khinchine), M/D/1 and M/Ek/1 models on the Model Comparison page show how the queue changes when service is less variable than exponential; for the same λ and μ, lower service variance always gives a shorter queue."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Assumption 4: FCFS + Infinite Queue -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,10" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="A4" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Assumption: FCFS Queuing + Infinite Queue Capacity"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="#2B1412" BorderBrush="{StaticResource StatusRedBorder}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Known Limitation" FontSize="9" Foreground="{StaticResource StatusRedText}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="18">
                        <Run Text="All M/M/c, M/G/1, and DES models assume First-Come-First-Served discipline and infinite queue capacity.&#10;&#10;"/>
                        <Run Text="Reality: the physical forecourt has limited space before vehicles spill onto the road, and drivers who see a long queue may leave. The models do not capture this, so very long queues predicted at high utilization would not fully occur in practice. The DES Q(t) chart shows how often long queues build up."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Assumption 5: Branch Routing -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,10" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="A5" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Implementation: Bifurcated Payment Branch Routing (4B vs 4A-5)"
                                   Style="{StaticResource CardTitle}"/>
                        <Border Background="{StaticResource StatusGreenBg}" BorderBrush="{StaticResource StatusGreenBorder}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="✓ Domain-Accurate" FontSize="9" Foreground="{StaticResource StatusGreenText}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" LineHeight="18">
                        <Run Text="Branch 4B (Cash): all cash payers, motorbikes and cars. Fast-exit cash payment handled by the attendant; no receipt required.&#10;&#10;"/>
                        <Run Text="Branch 4A-5 (Card/QR): electronic payment with POS terminal, PIN entry, receipt printing and handover. The DES adds a random Uniform[10, 25] s overhead to these vehicles. In the model, all motorbikes pay cash and half of the cars pay by card or QR, so 0.3 × 0.5 = 15% of vehicles use this path, all of them cars."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Methodology Compliance Checklist -->
            <Border Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,0" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Methodology &amp; Syllabus Compliance Checklist"
                                   Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="☑ Pearson χ² Goodness of Fit"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="☑ IQR Outliers (service times)"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="☑ Little's Law checked (time-avg L vs λ·W)"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,4,0">
                            <TextBlock Text="☑ Erlang-C Multi-Server"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="☑ Pollaczek-Khinchine (M/G/1)"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="☑ Inverse-Transform Sampling"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="☑ Event-List DES (Forecourt)"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="☑ 70/30 Fleet Mix (parameter)"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                            <TextBlock Text="☑ Shortest-Queue Heuristic"
                                       FontSize="11.5" Foreground="{StaticResource StatusGreenText}"/>
                        </StackPanel>
                    </UniformGrid>

                    <Separator Margin="0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Attribution: " FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Syed Haziq Zia Naqvi &amp; Group G  ·  Department of Computer Science (UBIT), University of Karachi  ·  Modeling &amp; Simulation, 2026"
                                   FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
