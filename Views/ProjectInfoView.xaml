<UserControl x:Class="FuelQ.Views.ProjectInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelQ.Controls"
             Background="{StaticResource CanvasBackground}"
             FontFamily="{StaticResource BodyFont}">
    <UserControl.Resources>
        <!-- Small pill used in the hero -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <!-- Module tile pieces -->
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stroke" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- Team member row -->
        <Style x:Key="MemberName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="MemberSeat" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">

            <!-- ══ HERO: the question + a live forecourt ══ -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <WrapPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource Chip}" BorderBrush="#5C4A26">
                            <TextBlock Text="SHELL · MASKAN CHOWRANGI" Style="{StaticResource ChipText}" Foreground="{StaticResource AccentCyanBrush}"/>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock Text="GROUP G · UBIT · BSCS 6th" Style="{StaticResource ChipText}"/>
                        </Border>
                    </WrapPanel>

                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold" LineHeight="40"
                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap">
                        <Run Text="How long will drivers"/>
                        <Run Text="wait at the pump?" Foreground="{StaticResource AccentCyanBrush}"/>
                    </TextBlock>

                    <TextBlock Text="FuelQ models the Shell forecourt at Maskan Chowrangi, Karachi. Vehicles arrive, queue, fuel up and leave. FuelQ predicts the waits with queueing formulas, then checks them with a vehicle-by-vehicle simulation."
                               FontSize="13.5" LineHeight="21" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Tag="1" Click="NavCard_Click" Style="{StaticResource PrimaryButton}" Padding="20,11" Margin="0,0,10,0">
                            <TextBlock Text="Start with the calculator  →"/>
                        </Button>
                        <Button Tag="2" Click="NavCard_Click" Style="{StaticResource SecondaryButton}" Padding="18,10" Content="Run a simulation"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="10">
                    <StackPanel>
                        <controls:ForecourtLive Height="250"/>
                        <TextBlock Margin="6,10,6,2" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}">
                            <Run Text="LIVE DEMO" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource AccentCyanBrush}"/>
                            <Run Text="  Vehicles arrive at random (rate λ), wait in the queue, and each pump fuels one at a time (rate μ). Every page of FuelQ studies this process."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ HOW IT WORKS ══ -->
            <TextBlock Text="HOW FUELQ WORKS" Style="{StaticResource SectionLabel}"/>
            <controls:StepGuide Steps="Model it :: Formulas predict the average wait from the arrival rate, the fueling rate and the number of pumps.|Simulate it :: Thousands of random vehicles are sent through the pumps one by one, and every wait is recorded.|Check it :: Formula and simulation should agree. The data page tests the assumption that arrivals are random."/>

            <!-- ══ MODULES ══ -->
            <TextBlock Text="THE TOOLS" Style="{StaticResource SectionLabel}"/>
            <UniformGrid Columns="3" Margin="-6,0,-6,16">
                <Button Tag="1" Click="NavCard_Click" Style="{StaticResource CardButton}" Padding="18,16" Margin="6">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="01" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Queue Calculator" Style="{StaticResource TileTitle}"/>
                            <TextBlock Text="Enter arrivals, fueling time and pumps. Get the average wait and queue length instantly, from six queueing models." Style="{StaticResource TileText}"/>
                        </StackPanel>
                        <Path Data="{StaticResource IconFormula}" Style="{StaticResource TileIcon}"/>
                    </Grid>
                </Button>
                <Button Tag="2" Click="NavCard_Click" Style="{StaticResource CardButton}" Padding="18,16" Margin="6">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="02" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="DES Simulator" Style="{StaticResource TileTitle}"/>
                            <TextBlock Text="Simulate 20,000 vehicles one at a time. See every random draw, the queue over time, and how close it lands to theory." Style="{StaticResource TileText}"/>
                        </StackPanel>
                        <Path Data="{StaticResource IconPump}" Style="{StaticResource TileIcon}"/>
                    </Grid>
                </Button>
                <Button Tag="3" Click="NavCard_Click" Style="{StaticResource CardButton}" Padding="18,16" Margin="6">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="03" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Empirical Data" Style="{StaticResource TileTitle}"/>
                            <TextBlock Text="Load or generate arrival records, flag odd service times, and run a χ² test: are arrivals really random?" Style="{StaticResource TileText}"/>
                        </StackPanel>
                        <Path Data="{StaticResource IconBars}" Style="{StaticResource TileIcon}"/>
                    </Grid>
                </Button>
                <Button Tag="4" Click="NavCard_Click" Style="{StaticResource CardButton}" Padding="18,16" Margin="6">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="04" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="Model Comparison" Style="{StaticResource TileTitle}"/>
                            <TextBlock Text="Put every model side by side, see how the queue explodes as pumps get busier, and export the table to LaTeX." Style="{StaticResource TileText}"/>
                        </StackPanel>
                        <Path Data="{StaticResource IconCurves}" Style="{StaticResource TileIcon}"/>
                    </Grid>
                </Button>
                <Button Tag="5" Click="NavCard_Click" Style="{StaticResource CardButton}" Padding="18,16" Margin="6">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="05" Style="{StaticResource TileNumber}"/>
                            <TextBlock Text="AI Prompts &amp; Audit" Style="{StaticResource TileTitle}"/>
                            <TextBlock Text="How the app was built, the assumptions behind every model, and where those assumptions stop holding." Style="{StaticResource TileText}"/>
                        </StackPanel>
                        <Path Data="{StaticResource IconAudit}" Style="{StaticResource TileIcon}"/>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- ══ SITE BASELINE + TEAM ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="SITE BASELINE (DEFAULT INPUTS)" Style="{StaticResource SectionLabel}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,12,14">
                                <TextBlock Text="Pumps (s)" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="2 – 4" Style="{StaticResource MeterValue}" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Parallel dispensers" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,14">
                                <TextBlock Text="Time between arrivals" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Style="{StaticResource MeterValue}" Foreground="{StaticResource AccentCyanBrush}"><Run Text="3.0"/><Run Text=" min" FontSize="14" Foreground="{StaticResource TextSecondary}"/></TextBlock>
                                <TextBlock Text="20 vehicles per hour, random" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,4">
                                <TextBlock Text="Fueling time" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Style="{StaticResource MeterValue}" Foreground="{StaticResource StatusGreenText}"><Run Text="2.0"/><Run Text=" min" FontSize="14" Foreground="{StaticResource TextSecondary}"/></TextBlock>
                                <TextBlock Text="Average per vehicle" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Stability (ρ &lt; 1)" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="Checked live" Style="{StaticResource MeterValue}" Foreground="{StaticResource AmberSoft}"/>
                                <TextBlock Text="Unstable inputs are flagged" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="20,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="PROJECT TEAM · GROUP G" Style="{StaticResource SectionLabel}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource TextSecondary}">
                                <Run Text="Supervisor "/><Run Text="Dr. Shaista Rais" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </Grid>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,4,8,8">
                                <TextBlock Text="Muhammad Noman" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006067" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="Syed Haziq Zia Naqvi" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006102" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Syed Abdul Ali Naqvi" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006092" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Hasan Kamran" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006027" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Syed Muhammad Ahmed" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006112" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Syed Abeer Bin Haider" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006094" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Usama Khan" Style="{StaticResource MemberName}"/>
                                <TextBlock Text="EB24210006124" Style="{StaticResource MemberSeat}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
